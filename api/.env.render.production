# ====================================================================
# RENDER PRODUCTION ENVIRONMENT - API SERVICE
# ====================================================================
# 
# 📁 LOCATION: /api/.env.render.production
# 🚀 PURPOSE: Production environment variables for API on Render
#
# ⚠️  CRITICAL INSTRUCTIONS:
# 1. Copy ALL variables below to Render Dashboard → API Service → Environment
# 2. Replace placeholder values (YOUR_*, CHANGE_ME) with actual values
# 3. DO NOT commit this file with real secrets to Git
# 4. Update UI_URL after deploying UI service first
# 5. Each variable must be added separately in Render dashboard
#
# 📝 DEPLOYMENT ORDER:
# Step 1: Deploy API first (you can use temporary CORS values)
# Step 2: Note the API URL (e.g., https://meatlovers-api.onrender.com)
# Step 3: Deploy UI with API URL
# Step 4: Update API's ALLOWED_ORIGINS and FRONTEND_URL with UI URL
# Step 5: Trigger API redeploy
#
# ====================================================================

# ────────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (REQUIRED)
# ────────────────────────────────────────────────────────────────────
# ⚠️  CRITICAL: This MUST be your production PostgreSQL connection string
# 📌 Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# 🔐 Keep this secret! Never share or commit to Git
# 💡 Your Neon database connection (already configured)
DATABASE_URL="postgresql://neondb_owner:npg_VR8T4DJPMyOq@ep-little-dust-axitggkv-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ────────────────────────────────────────────────────────────────────
# 2. JWT & AUTHENTICATION (REQUIRED)
# ────────────────────────────────────────────────────────────────────
# ⚠️  CRITICAL: Your production JWT secret (already strong - 128 chars)
# � NEVER share this secret
# ✅ This is a strong production-ready secret
JWT_SECRET="57dca31cbf2dcd2a9aaeb987f0282d8baa5fcfa9ed13965b7024c55f6972f6572e32358df2377897161651d3f987a4ac86afb7c41b57e3cb2987ef42bbd52125"

# 📝 Optional: JWT token expiration times (defaults shown)
# JWT_ACCESS_TOKEN_EXPIRY="15m"
# JWT_REFRESH_TOKEN_EXPIRY="7d"

# ────────────────────────────────────────────────────────────────────
# 3. APPLICATION CONFIGURATION (REQUIRED)
# ────────────────────────────────────────────────────────────────────
# ⚠️  CRITICAL: MUST be "production" for Render deployment
# ⚠️  You currently have "development" - THIS MUST BE CHANGED!
NODE_ENV="production"

# 📌 Render automatically sets PORT, but we specify 10000 as default
# ℹ️  Render will override this with its own PORT if needed
PORT=10000

# ────────────────────────────────────────────────────────────────────
# 4. CORS CONFIGURATION (CRITICAL)
# ────────────────────────────────────────────────────────────────────
# ⚠️  CRITICAL: Update this AFTER deploying UI service
# 📝 Currently pointing to Vercel - WILL CHANGE to Render UI URL
# 
# 🚀 CURRENT SETUP (until UI is deployed on Render):
#    You have: https://meatlovers.vercel.app/
#    Keep this temporarily for backward compatibility
#
# 🚀 AFTER UI DEPLOYMENT ON RENDER:
#    Add your new Render UI URL (e.g., https://meatlovers-ui.onrender.com)
#    Example: "https://meatlovers.vercel.app,https://meatlovers-ui.onrender.com"
#
# ⚠️  Multiple origins: Separate with commas, NO spaces
# ⚠️  Remove Vercel URL once fully migrated to Render
ALLOWED_ORIGINS="https://meatlovers.vercel.app"

# 📌 Frontend URL for redirects and email links
# ⚠️  Update this with your UI URL after deployment
# 🚀 TEMPORARY: Keep Vercel URL until Render UI is deployed
FRONTEND_URL="https://meatlovers.vercel.app"

# ────────────────────────────────────────────────────────────────────
# 5. EMAIL CONFIGURATION (OPTIONAL - for password reset)
# ────────────────────────────────────────────────────────────────────
# 💡 Only needed if using password reset functionality
# 📧 Gmail users: Generate App Password at https://myaccount.google.com/apppasswords
# ⚠️  Do NOT use your actual Gmail password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-gmail-app-specific-password"

# 📌 Email sender details
SMTP_FROM_NAME="Meat Lovers CIMS"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

# ────────────────────────────────────────────────────────────────────
# 6. PRISMA CONFIGURATION (OPTIONAL)
# ────────────────────────────────────────────────────────────────────
# 📝 Connection pooling for better performance
# 💡 Recommended for production: 10-20 connections
# DATABASE_POOL_SIZE=10

# 📝 Query logging (disable in production for performance)
# DATABASE_LOG_QUERIES=false

# ────────────────────────────────────────────────────────────────────
# 7. SECURITY CONFIGURATION (OPTIONAL)
# ────────────────────────────────────────────────────────────────────
# 🔐 Rate limiting (already configured in code, these are defaults)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# 🔐 Account lockout after failed login attempts
# MAX_LOGIN_ATTEMPTS=5
# ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ────────────────────────────────────────────────────────────────────
# 8. FEATURE FLAGS (OPTIONAL)
# ────────────────────────────────────────────────────────────────────
# ENABLE_API_DOCS=false
# ENABLE_SWAGGER=false
# MAINTENANCE_MODE=false

# ────────────────────────────────────────────────────────────────────
# 9. LOGGING & MONITORING (OPTIONAL)
# ────────────────────────────────────────────────────────────────────
# LOG_LEVEL="info"
# SENTRY_DSN="your-sentry-dsn-here"

# ====================================================================
# ✅ CHECKLIST BEFORE DEPLOYING:
# ====================================================================
# [ ] DATABASE_URL is correct and accessible
# [ ] JWT_SECRET is strong and unique (32+ characters)
# [ ] NODE_ENV is set to "production"
# [ ] ALLOWED_ORIGINS will be updated after UI deployment
# [ ] FRONTEND_URL will be updated after UI deployment
# [ ] Email credentials are correct (if using email features)
# [ ] All sensitive values are kept secret (not committed to Git)
#
# ====================================================================
# 🚀 RENDER DEPLOYMENT STEPS:
# ====================================================================
# 1. Go to Render Dashboard → New → Web Service
# 2. Connect your Git repository
# 3. Configure:
#    - Name: meatlovers-api
#    - Root Directory: api
#    - Environment: Node
#    - Build Command: npm install && npm run prisma:generate && npm run build
#    - Start Command: npm run start:prod
# 4. Add environment variables from this file (one by one)
# 5. Click "Create Web Service"
# 6. Wait for deployment (3-5 minutes)
# 7. Note your API URL: https://YOUR-SERVICE.onrender.com
# 8. Test health endpoint: curl https://YOUR-SERVICE.onrender.com/health
#
# ====================================================================
# 🔧 POST-DEPLOYMENT:
# ====================================================================
# After deploying UI, come back and update:
# - ALLOWED_ORIGINS=https://your-actual-ui-url.onrender.com
# - FRONTEND_URL=https://your-actual-ui-url.onrender.com
# Then trigger a redeploy of the API service
#
# ====================================================================
