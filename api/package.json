{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "scan:auth": "ts-node -r tsconfig-paths/register src/auth/cli/scan-authorization.ts",
    "auth:test": "ts-node -r tsconfig-paths/register src/auth/cli/test-authorization.ts",
    "auth:test:report": "ts-node -r tsconfig-paths/register src/auth/cli/test-authorization.ts --report",
    "auth:test:security": "ts-node -r tsconfig-paths/register src/auth/cli/test-authorization.ts --security",
    "auth:test:validate": "ts-node -r tsconfig-paths/register src/auth/cli/test-authorization.ts --validate",
    "test:authorization": "jest --config test/jest-e2e.json authorization-coverage role-authorization --runInBand",
    "test:unit": "jest",
    "report:roles": "ts-node -r tsconfig-paths/register scripts/generate-role-guard-report.ts",
    "certify:authorization": "npm run build && npm run test:unit && npm run test:authorization && npm run report:roles",
    "coverage:report": "ts-node -r tsconfig-paths/register src/auth/cli/generate-coverage-report.ts",
    "coverage:report:md": "REPORT_FORMAT=markdown ts-node -r tsconfig-paths/register src/auth/cli/generate-coverage-report.ts",
    "coverage:report:json": "REPORT_FORMAT=json ts-node -r tsconfig-paths/register src/auth/cli/generate-coverage-report.ts",
    "coverage:report:csv": "REPORT_FORMAT=csv ts-node -r tsconfig-paths/register src/auth/cli/generate-coverage-report.ts",
    "coverage:check": "EXIT_ON_FAILURE=true VERBOSE=true ts-node -r tsconfig-paths/register src/auth/cli/generate-coverage-report.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-multi-lang": "^0.140.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
