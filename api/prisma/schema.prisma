// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAITER
  CHEF
  STOREKEEPER
  BARMAN
  DISPATCHER
  ACCOUNTANT
  HR
}

model User {
  id            BigInt   @id @default(autoincrement())
  full_name     String   @db.VarChar(255)
  email         String?  @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(50)
  password_hash String   @db.Text
  role          Role
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  price_change_audits PriceChangeAuditTrail[]
  orders Order[]
  rider Rider?
  waste_declarations WasteDeclaration[]
  finance_transactions FinanceTransaction[]

  @@map("users")
}

enum SupplierType {
  FOOD
  SOFT_DRINKS
  ALCOHOL
  GENERAL
}

enum SupplierStatus {
  ACTIVE
  SUSPENDED
}

enum ProductCategory {
  FOOD
  SOFT_DRINK
  ALCOHOLIC_DRINK
}

enum PricingRuleType {
  FIXED_PRICE
  PERCENT_INCREASE
  PERCENT_DECREASE
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model PricingRule {
  id                BigInt           @id @default(autoincrement())
  name              String          @db.VarChar(255)
  rule_type         PricingRuleType
  value             Decimal         @db.Decimal(12, 2)
  product_category  ProductCategory?
  min_selling_price Decimal?
  max_selling_price Decimal?

  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  price_change_audits PriceChangeAuditTrail[]

  @@map("pricing_rules")
}

model PriceChangeAuditTrail {
  id BigInt @id @default(autoincrement())

  product_id          BigInt
  pricing_rule_id     BigInt?
  actor_user_id       BigInt

  old_selling_price   Decimal @db.Decimal(12, 2)
  new_selling_price   Decimal @db.Decimal(12, 2)

  note String? @db.Text
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id])
  pricing_rule PricingRule? @relation(fields: [pricing_rule_id], references: [id])
  actor User @relation(fields: [actor_user_id], references: [id])

  @@index([product_id])
  @@index([pricing_rule_id])
  @@index([actor_user_id])

  @@map("price_change_audit_trails")
}

model Supplier {

  id               BigInt         @id @default(autoincrement())
  supplier_name    String         @db.VarChar(255)
  contact_person   String?        @db.VarChar(255)
  phone            String?        @db.VarChar(50)
  email            String?        @db.VarChar(255)
  physical_address String?        @db.Text
  supplier_type    SupplierType
  status           SupplierStatus @default(ACTIVE)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@map("suppliers")
}

model Product {
  id               BigInt          @id @default(autoincrement())
  product_name    String          @db.VarChar(255)
  product_category ProductCategory
  selling_price   Decimal         @db.Decimal(12, 2)
  cost_price      Decimal         @db.Decimal(12, 2)
  barcode          String?         @db.VarChar(255)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  price_change_audits PriceChangeAuditTrail[]
  stock_item         StockItem?
  recipe             Recipe?
  waste_declarations WasteDeclaration[]

  @@map("products")
}

model Table {
  id         BigInt   @id @default(autoincrement())
  table_name String?  @db.VarChar(255)

  orders     Order[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tables")
}

model Order {
  id            BigInt       @id @default(autoincrement())
  table_id      BigInt
  waiter_id     BigInt
  status        OrderStatus @default(PENDING)
  total_amount  Float

  items         OrderItem[]
  payments      Payment[]
  delivery      Delivery?

  waiter        User         @relation(fields: [waiter_id], references: [id])
  table         Table        @relation(fields: [table_id], references: [id])

  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@map("orders")
  @@index([table_id])
  @@index([waiter_id])
}

model OrderItem {
  id           BigInt  @id @default(autoincrement())
  order_id     BigInt
  product_id   BigInt?
  product_name String  @db.VarChar(255)

  quantity     Int
  unit_price   Float
  line_total   Float

  order        Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@index([order_id])
}

enum MovementType {
  PURCHASE
  ADJUSTMENT
  TRANSFER
  WASTE
}

enum MarginAlertStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

model StockItem {
  id          BigInt   @id @default(autoincrement())
  product_id  BigInt   @unique
  quantity    Int      @default(0)
  location    String   @default("MAIN_STORE") @db.VarChar(100)

  product     Product            @relation(fields: [product_id], references: [id])
  movements   StockMovement[]
  recipe_ingredients RecipeIngredient[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("stock_items")
  @@index([product_id])
}

model StockMovement {
  id            BigInt       @id @default(autoincrement())
  stock_item_id BigInt
  movement_type MovementType
  quantity      Int
  reference     String?      @db.VarChar(255)
  notes         String?      @db.Text

  stock_item    StockItem    @relation(fields: [stock_item_id], references: [id], onDelete: Cascade)

  created_at    DateTime     @default(now())

  @@map("stock_movements")
  @@index([stock_item_id])
}

model Payment {
  id                   BigInt         @id @default(autoincrement())
  order_id             BigInt
  payment_method       PaymentMethod
  amount               Decimal        @db.Decimal(12, 2)
  transaction_reference String?        @db.VarChar(255)
  payment_status       PaymentStatus  @default(PENDING)

  order                Order          @relation(fields: [order_id], references: [id])

  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@map("payments")
  @@index([order_id])
}

model MarginAlert {
  id           BigInt           @id @default(autoincrement())
  alert_status MarginAlertStatus @default(OPEN)
  notes        String?          @db.Text
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  @@map("margin_alerts")
}

model Recipe {
  id          BigInt             @id @default(autoincrement())
  product_id  BigInt             @unique
  name        String             @db.VarChar(255)
  instructions String?          @db.Text
  is_active   Boolean            @default(true)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  product     Product            @relation(fields: [product_id], references: [id])
  ingredients RecipeIngredient[]
  production_plans ProductionPlan[]

  @@map("recipes")
  @@index([product_id])
}

model RecipeIngredient {
  id              BigInt   @id @default(autoincrement())
  recipe_id       BigInt
  stock_item_id   BigInt
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String   @default("units") @db.VarChar(50)

  recipe          Recipe   @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  stock_item      StockItem @relation(fields: [stock_item_id], references: [id])

  @@map("recipe_ingredients")
  @@index([recipe_id])
  @@index([stock_item_id])
}

enum ProductionPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionPlan {
  id                BigInt                @id @default(autoincrement())
  recipe_id         BigInt
  planned_quantity  Int
  produced_quantity Int                   @default(0)
  status            ProductionPlanStatus   @default(PLANNED)
  planned_date      DateTime
  completed_date    DateTime?
  notes             String?               @db.Text

  recipe            Recipe                @relation(fields: [recipe_id], references: [id])

  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  @@map("production_plans")
  @@index([recipe_id])
  @@index([status])
  @@index([planned_date])
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Rider {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt   @unique
  phone       String   @db.VarChar(50)
  license_number String? @db.VarChar(100)
  vehicle_type String? @db.VarChar(50)
  vehicle_plate String? @db.VarChar(50)
  is_available Boolean  @default(true)
  current_location String? @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])
  deliveries  Delivery[]

  @@map("riders")
  @@index([user_id])
}

model Delivery {
  id          BigInt         @id @default(autoincrement())
  order_id    BigInt         @unique
  rider_id    BigInt
  status      DeliveryStatus @default(ASSIGNED)
  pickup_address String?     @db.Text
  delivery_address String    @db.Text
  delivery_notes String?     @db.Text
  assigned_at DateTime       @default(now())
  picked_up_at DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  cancellation_reason String? @db.Text

  order       Order          @relation(fields: [order_id], references: [id])
  rider       Rider          @relation(fields: [rider_id], references: [id])

  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@map("deliveries")
  @@index([order_id])
  @@index([rider_id])
  @@index([status])
}

enum WasteReason {
  EXPIRED
  SPOILED
  OVERPRODUCTION
  QUALITY_ISSUE
  CUSTOMER_RETURN
  THEFT
  OTHER
}

model WasteDeclaration {
  id          BigInt       @id @default(autoincrement())
  product_id  BigInt
  quantity    Int
  reason      WasteReason
  notes       String?      @db.Text
  declared_by BigInt
  cost_value  Decimal      @db.Decimal(12, 2)
  declared_at DateTime     @default(now())

  product     Product      @relation(fields: [product_id], references: [id])
  declarer    User         @relation(fields: [declared_by], references: [id])

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  @@map("waste_declarations")
  @@index([product_id])
  @@index([declared_by])
  @@index([reason])
  @@index([declared_at])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALES
  SUPPLIER_PAYMENT
  SALARY
  RENT
  UTILITIES
  MAINTENANCE
  EQUIPMENT
  MARKETING
  WASTE_LOSS
  DELIVERY
  OTHER
}

model FinanceTransaction {
  id          BigInt             @id @default(autoincrement())
  type        TransactionType
  category    TransactionCategory
  amount      Decimal            @db.Decimal(12, 2)
  description String?            @db.Text
  reference   String?            @db.VarChar(255)
  recorded_by BigInt
  transaction_date DateTime      @default(now())

  recorder    User               @relation(fields: [recorded_by], references: [id])

  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  @@map("finance_transactions")
  @@index([type])
  @@index([category])
  @@index([recorded_by])
  @@index([transaction_date])
}
