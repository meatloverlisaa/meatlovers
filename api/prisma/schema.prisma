// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAITER
  CHEF
  STOREKEEPER
  BARMAN
  DISPATCHER
  ACCOUNTANT
  HR
}

model User {
  id            BigInt   @id @default(autoincrement())
  full_name     String   @db.VarChar(255)
  email         String?  @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(50)
  password_hash String   @db.Text
  role          Role
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  price_change_audits PriceChangeAuditTrail[]
  orders Order[]

  @@map("users")
}

enum SupplierType {
  FOOD
  SOFT_DRINKS
  ALCOHOL
  GENERAL
}

enum SupplierStatus {
  ACTIVE
  SUSPENDED
}

enum ProductCategory {
  FOOD
  SOFT_DRINK
  ALCOHOLIC_DRINK
}

enum PricingRuleType {
  FIXED_PRICE
  PERCENT_INCREASE
  PERCENT_DECREASE
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PricingRule {
  id                BigInt           @id @default(autoincrement())
  name              String          @db.VarChar(255)
  rule_type         PricingRuleType
  value             Decimal         @db.Decimal(12, 2)
  product_category  ProductCategory?
  min_selling_price Decimal?
  max_selling_price Decimal?

  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  price_change_audits PriceChangeAuditTrail[]

  @@map("pricing_rules")
}

model PriceChangeAuditTrail {
  id BigInt @id @default(autoincrement())

  product_id          BigInt
  pricing_rule_id     BigInt?
  actor_user_id       BigInt

  old_selling_price   Decimal @db.Decimal(12, 2)
  new_selling_price   Decimal @db.Decimal(12, 2)

  note String? @db.Text
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id])
  pricing_rule PricingRule? @relation(fields: [pricing_rule_id], references: [id])
  actor User @relation(fields: [actor_user_id], references: [id])

  @@index([product_id])
  @@index([pricing_rule_id])
  @@index([actor_user_id])

  @@map("price_change_audit_trails")
}

model Supplier {

  id               BigInt         @id @default(autoincrement())
  supplier_name    String         @db.VarChar(255)
  contact_person   String?        @db.VarChar(255)
  phone            String?        @db.VarChar(50)
  email            String?        @db.VarChar(255)
  physical_address String?        @db.Text
  supplier_type    SupplierType
  status           SupplierStatus @default(ACTIVE)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@map("suppliers")
}

model Product {
  id               BigInt          @id @default(autoincrement())
  product_name    String          @db.VarChar(255)
  product_category ProductCategory
  selling_price   Decimal         @db.Decimal(12, 2)
  cost_price      Decimal         @db.Decimal(12, 2)
  barcode          String?         @db.VarChar(255)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  price_change_audits PriceChangeAuditTrail[]
  stock_item         StockItem?

  @@map("products")
}

model Table {
  id         BigInt   @id @default(autoincrement())
  table_name String?  @db.VarChar(255)

  orders     Order[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tables")
}

model Order {
  id            BigInt       @id @default(autoincrement())
  table_id      BigInt
  waiter_id     BigInt
  status        OrderStatus @default(PENDING)
  total_amount  Float

  items         OrderItem[]
  payments      Payment[]

  waiter        User         @relation(fields: [waiter_id], references: [id])
  table         Table        @relation(fields: [table_id], references: [id])

  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@map("orders")
  @@index([table_id])
  @@index([waiter_id])
}

model OrderItem {
  id           BigInt  @id @default(autoincrement())
  order_id     BigInt
  product_id   BigInt?
  product_name String  @db.VarChar(255)

  quantity     Int
  unit_price   Float
  line_total   Float

  order        Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@index([order_id])
}

enum MovementType {
  PURCHASE
  ADJUSTMENT
  TRANSFER
  WASTE
}

model StockItem {
  id          BigInt   @id @default(autoincrement())
  product_id  BigInt   @unique
  quantity    Int      @default(0)
  location    String   @default("MAIN_STORE") @db.VarChar(100)

  product     Product  @relation(fields: [product_id], references: [id])
  movements   StockMovement[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("stock_items")
  @@index([product_id])
}

model StockMovement {
  id            BigInt       @id @default(autoincrement())
  stock_item_id BigInt
  movement_type MovementType
  quantity      Int
  reference     String?      @db.VarChar(255)
  notes         String?      @db.Text

  stock_item    StockItem    @relation(fields: [stock_item_id], references: [id], onDelete: Cascade)

  created_at    DateTime     @default(now())

  @@map("stock_movements")
  @@index([stock_item_id])
}

model Payment {
  id                   BigInt         @id @default(autoincrement())
  order_id             BigInt
  payment_method       PaymentMethod
  amount               Decimal        @db.Decimal(12, 2)
  transaction_reference String?        @db.VarChar(255)
  payment_status       PaymentStatus  @default(PENDING)

  order                Order          @relation(fields: [order_id], references: [id])

  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@map("payments")
  @@index([order_id])
}
