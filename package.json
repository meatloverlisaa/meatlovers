{
  "name": "meat-lovers-cims-powered-by-yohpal",
  "private": true,
  "workspaces": [
    "apps/website",
    "apps/admin-web",
    "apps/pos-pwa",
    "apps/monitoring-web"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "website:dev": "pnpm --filter meat-lovers-website dev",
    "admin:dev": "pnpm --filter meat-lovers-admin-web dev",
    "pos:dev": "pnpm --filter meat-lovers-pos-pwa dev",
    "monitoring:dev": "pnpm --filter meat-lovers-monitoring-web dev",
    "website:build": "pnpm --filter meat-lovers-website build",
    "admin:build": "pnpm --filter meat-lovers-admin-web build",
    "pos:build": "pnpm --filter meat-lovers-pos-pwa build",
    "monitoring:build": "pnpm --filter meat-lovers-monitoring-web build"
  }
}
